// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Nomes de model no Prisma devem estar
// no singular e iniciar com LetraMaiúscula
model Categoria {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  descricao   String
  produtos    Produto[]
}

model Cliente {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  nome              String
  cpf               String   @unique     // Não pode se repetir na coleção
  data_nascimento   DateTime? // opcional
  email             String   @unique
  senha             String   // REINTRODUZIDO: Para fins de representação de dados
  logradouro        String
  num_imovel        String
  complemento       String? // opcional
  bairro            String
  municipio         String
  uf                String
  cep               String
  celular           String
  pedidos           Pedido[]
  participacoes     ParticipacaoEvento[] // Relação com Eventos
  comentarios       ComentarioProduto[] // Relação com Comentários de Produto
}

model Fornecedor {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  razao_social    String
  nome_fantasia   String?
  cnpj            String        @unique
  email           String        @unique
  logradouro      String
  num_casa        String
  complemento     String?
  bairro          String
  municipio       String
  uf              String
  cep             String
  celular         String
  produtos        Produto[]     @relation(fields: [produto_ids], references: [id])
  produto_ids     String[]      @db.ObjectId
}

model Pedido {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  num_pedido   Int        @unique
  data_hora    DateTime   @default(now())
  cliente_id   String     @db.ObjectId
  cliente      Cliente    @relation(fields: [cliente_id], references: [id])
  itens        ItemPedido[]
  // NOVO: status para Carrinho (e.g., 'pending' para carrinho, 'ordered' para compra finalizada)
  status       String     @default("pending") 
}

model Produto {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  nome             String
  marca            String
  detalhes         String?
  quantidade       Float
  unidade_medida   String
  preco_unitario   Float
  qtd_estoque      Float
  categoria_id     String           @db.ObjectId
  categoria        Categoria        @relation(fields: [categoria_id], references: [id])
  fornecedores     Fornecedor[]     @relation(fields: [fornecedor_ids], references: [id])
  fornecedor_ids   String[]         @db.ObjectId
  itens_pedido     ItemPedido[]
  comentarios      ComentarioProduto[] // Relação com Comentários
}


model ItemPedido {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  num_item   Int
  quantidade Float
  produto_id String   @db.ObjectId
  produto    Produto  @relation(fields: [produto_id], references: [id])
  pedido_id  String   @db.ObjectId
  pedido     Pedido   @relation(fields: [pedido_id], references: [id])

  @@unique([pedido_id, num_item])
}

model Artista {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  nome            String   @unique
  genero_musical  String   @map("generoMusical")
  bio             String?
  redes_sociais   String[] @map("redesSociais")
  links_musica    String[] // NOVO: links de música/spotify
  fotos_perfil    String[] // NOVO: fotos do artista
  email           String   @unique
  senha           String   // REINTRODUZIDO: Para fins de representação de dados
  telefone        String?
  eventos         Evento[]
}

model Evento {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  artista_id     String   @db.ObjectId @map("artistaID")
  artista        Artista  @relation(fields: [artista_id], references: [id])
  data           DateTime
  local          String
  nome           String? // NOVO: nome do evento
  horario        String? // NOVO: horário do evento
  link_ingresso  String? // NOVO: link para compra do ingresso
  descricao      String?
  preco_ingresso Float    @map("precoIngresso")
  participacoes  ParticipacaoEvento[] // Relação com Participações

  @@index([artista_id])
}

// NOVO MODELO: Para os comentários/reviews de produtos
model ComentarioProduto {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  texto       String
  avaliacao   Int?     // Nota de 1 a 5, opcional
  data_criacao DateTime @default(now())
  
  produto_id  String   @db.ObjectId
  produto     Produto  @relation(fields: [produto_id], references: [id])
  
  cliente_id  String   @db.ObjectId
  cliente     Cliente  @relation(fields: [cliente_id], references: [id])
}

// NOVO MODELO: Para a participação/compra de ingresso para eventos (relação N:M)
model ParticipacaoEvento {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  data_compra DateTime @default(now())
  
  evento_id   String   @db.ObjectId
  evento      Evento   @relation(fields: [evento_id], references: [id])
  
  cliente_id  String   @db.ObjectId
  cliente     Cliente  @relation(fields: [cliente_id], references: [id])
  
  @@unique([evento_id, cliente_id])
}